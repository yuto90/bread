{
  "name": "bread",
  "version": "0.1.0-preview.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "bread": "bin/bread"
  },
  "scripts": {
    "check": "node src/cli.ts check examples/blink.bread",
    "render": "node src/cli.ts render examples/blink.bread -o output/blink.svg",
    "test": "node --test tests/*.test.ts tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "playground": "node scripts/serve-playground.ts",
    "build:playground": "node scripts/build-playground.ts",
    "build": "npm run build:playground",
    "test:browser": "playwright test",
    "verify:build": "node scripts/verify-build.ts",
    "verify": "npm run typecheck && npm test && npm run verify:build",
    "benchmark:routing": "node scripts/measure-routing.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "jsdom": "30.1.1",
    "typescript": "5.9.3",
    "wrangler": "4.147.0"
  },
  "description": "Connection-only wiring DSL with independent physical netlist verification",
  "packageManager": "npm@11.9.0",
  "license": "SEE LICENSE IN LICENSES/README.md"
}
