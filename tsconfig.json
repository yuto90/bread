{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "parts/**/*.ts",
    "tests/**/*.ts",
    "playground/**/*.ts",
    "scripts/build-playground.ts",
    "scripts/serve-playground.ts",
    "scripts/verify-build.ts",
    "playwright.config.ts",
    "e2e/**/*.ts"
  ]
}
